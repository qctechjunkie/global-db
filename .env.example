# Docker Data Path
# Base directory on the host where all container data is stored
DOCKER_DATA_PATH=/home/docker/global-db

# MariaDB Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_INITDB_SKIP_TZINFO=1

# MariaDB Performance Settings
INNODB_BUFFER_POOL_SIZE=128M
MAX_CONNECTIONS=50

# MariaDB Port Mapping
MARIADB_PORT=3306

# Container Names
MARIADB_CONTAINER_NAME=global-mariadb
PHPMYADMIN_CONTAINER_NAME=phpmyadmin

# Network Configuration
NETWORK_NAME=wp-network
NETWORK_EXTERNAL=true

# phpMyAdmin Configuration
PMA_HOST=global-mariadb
PMA_PORT=3306
PMA_CONTROLUSER=pma
PMA_CONTROLPASS=your_secure_pma_password_here
PMA_PMADB=phpmyadmin
PMA_CONTROLHOST=global-mariadb

# phpMyAdmin Port Mapping
PHPMYADMIN_PORT=8080

# phpMyAdmin Resource Limits
UPLOAD_LIMIT=1024M
MEMORY_LIMIT=5125M
MAX_EXECUTION_TIME=600

# Database Backup Configuration
BACKUP_CONTAINER_NAME=db-backup
MYSQL_HOST=global-mariadb
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_root_password_here
# Cron schedule format: minute hour day month weekday
# Examples:
#   0 2 * * *       = Daily at 2:00 AM
#   0 */6 * * *     = Every 6 hours
#   0 0 * * 0       = Weekly on Sunday at midnight
BACKUP_SCHEDULE=0 2 * * *
# Number of days to keep backups (0 = keep all)
RETENTION_DAYS=7
